# ─── Application ──
PORT=3000
MQTT_PORT=1883
NODE_ENV=development

# ─── Database (Aiven PostgreSQL) ──
# Get from Aiven console: Service connect URL
DATABASE_URL="postgresql://user:password@host:5432/defaultdb?sslmode=require"

# ─── Secrets ──
JWT_SECRET="your-jwt-secret-change-this"
GATEWAY_KEY="your-gateway-api-key-change-this"

# ─── External MQTT Broker (EMQX / HiveMQ Cloud TLS) ──
MQTT_URI="mqtts://your-emqx-broker.emqxsl.com:8883"
MQTT_USER="your_mqtt_username"
MQTT_PASS="your_mqtt_password"
