# Smart Clock & Industrial Edge IoT Gateway — Production Environment Variables

# PostgreSQL Database
POSTGRES_DB=smartclock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_production_password_change_me
DATABASE_URL=postgresql://postgres:secure_production_password_change_me@postgres:5432/smartclock?schema=public

# Backend Service
NODE_ENV=production
PORT=3000
MQTT_PORT=1883

# JWT Secret for Web App Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
REQUIRE_AUTH=true

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
